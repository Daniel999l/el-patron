# Launch wallet: every coin is created by this wallet and pump.fun creator fees land here (the bounty pot).
# Base58 secret key (Phantom export) or a JSON byte array. Keep it funded with ~0.05 SOL for network fees.
LAUNCHER_PRIVATE_KEY=
# What a user pays per launch, in USD worth of SOL (priced live from Jupiter; LAUNCH_FEE_SOL is the fallback).
LAUNCH_FEE_USD=2
LAUNCH_FEE_SOL=0.02
# A keyed Solana RPC (Helius, QuickNode, Triton). The public one rate-limits hard.
RPC_URL=https://api.mainnet-beta.solana.com
# The CRACKPAD token CA once it exists (shows the Buy button + CA box).
TOKEN_CA=
TOKEN_NAME=CRACKPAD
TOKEN_TICKER=CRACK
TG_URL=
MONGO_URI=
MONGO_DB=crackpad
DATA_DIR=./data
PRIORITY_MICROLAMPORTS=200000
